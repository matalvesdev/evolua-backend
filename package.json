{
  "name": "evolua-backend",
  "version": "2.0.2",
  "description": "Evolua backend monorepo — Fastify API + Python AI + Go services",
  "private": true,
  "workspaces": [
    "apps/api",
    "contracts"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=@evolua/api",
    "build:api": "npm run build --workspace=@evolua/api",
    "build:contracts": "npm run build --workspace=@evolua/contracts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "codegen": "tsx scripts/codegen.ts",
    "dev:ai": "cd apps/ai && uvicorn app.main:app --reload --port 8001",
    "dev:wa": "cd apps/services/whatsapp && go run ./cmd/server"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "resend": "^6.12.4"
  }
}
