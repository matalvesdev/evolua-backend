# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5177

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/evolua

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Email (Notifica) ---
# https://docs.usenotifica.com.br
NOTIFICA_API_URL=https://app.usenotifica.com.br/v1
NOTIFICA_API_KEY=
NOTIFICA_FROM_EMAIL=
NOTIFICA_FROM_NAME=Evolua

# SMTP fallback — usado quando Notifica falha
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Evolua

# --- Supabase Auth HTTP Hook ---
# HMAC secret usado pelo Supabase para chamar nossos hooks de autenticação
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPABASE_AUTH_HOOK_SECRET=

# --- Internal Services ---
AI_SERVICE_URL=http://localhost:8001
WHATSAPP_SERVICE_URL=http://localhost:8010
INTERNAL_SERVICE_TOKEN=change-me-in-production

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
