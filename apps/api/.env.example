# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5177

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/evolua

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Internal Services ---
AI_SERVICE_URL=http://localhost:8001
WHATSAPP_SERVICE_URL=http://localhost:8010
INTERNAL_SERVICE_TOKEN=change-me-in-production

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
