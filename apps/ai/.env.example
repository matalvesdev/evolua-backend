# Evolua AI Service - Variáveis de Ambiente
# Não comite valores reais. Em produção use o painel do provider.

ENVIRONMENT=production
PORT=8001
LOG_LEVEL=info

# Token compartilhado com Fastify gateway (mesmo valor de INTERNAL_SERVICE_TOKEN)
INTERNAL_SERVICE_TOKEN=change-me-in-prod-must-be-32-bytes-hex

# HuggingFace
# Hugging Face fica reservado aos embeddings do RAG interno.
HUGGINGFACE_API_KEY=hf_your_rag_embedding_token_here
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
HUGGINGFACE_EMBEDDING_DIM=384
OPENROUTER_API_KEY=sk-or-v1-your_token_here
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_CLINICAL_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_RAG_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TRANSCRIPTION_MODEL=qwen/qwen3-asr-1.7b

# Hosts HTTPS confiáveis para importação remota na Biblioteca (separados por
# vírgula). Obrigatório em staging/produção quando source_url for utilizado.
LIBRARY_INGEST_ALLOWED_HOSTS=.supabase.co

# Postgres com pgvector (mesma conexão do Fastify)
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

OTEL_ENABLED=false

# Sentry (opcional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
