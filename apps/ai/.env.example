# Evolua AI Service - Variáveis de Ambiente
# Não comite valores reais. Em produção use o painel do provider.

ENVIRONMENT=production
PORT=8001
LOG_LEVEL=info

# Token compartilhado com Fastify gateway (mesmo valor de INTERNAL_SERVICE_TOKEN)
INTERNAL_SERVICE_TOKEN=change-me-in-prod-must-be-32-bytes-hex

# HuggingFace
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_CHAT_PROVIDER=hf-inference
HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
HUGGINGFACE_EMBEDDING_DIM=384
HUGGINGFACE_WHISPER_MODEL=openai/whisper-large-v3

# Postgres com pgvector (mesma conexão do Fastify)
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

OTEL_ENABLED=false

# Sentry (opcional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
