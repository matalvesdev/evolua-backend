# Evolua WhatsApp Service (Go) - Variáveis de Ambiente
# Não comite valores reais. Em produção use o painel do provider.

ENVIRONMENT=production
PORT=8010
LOG_LEVEL=info

# Token compartilhado com Fastify gateway (mesmo INTERNAL_SERVICE_TOKEN)
INTERNAL_SERVICE_TOKEN=change-me-in-prod-must-be-32-bytes-hex

# Evolution API (provider de WhatsApp via Baileys)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-evolution
EVOLUTION_INSTANCE=evolua

# Provider legacy Meta (mantido para compat — não usado quando Evolution está ativo)
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# URL do gateway Fastify (para encaminhar webhooks inbound)
GATEWAY_URL=http://localhost:3000

# Secret HMAC-SHA256 para assinar webhooks enviados ao gateway.
# OBRIGATÓRIO em produção. Mesmo valor de EVOLUTION_WEBHOOK_SECRET no Fastify.
EVOLUTION_WEBHOOK_SECRET=
