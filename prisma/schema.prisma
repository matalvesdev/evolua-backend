// ============================================================================
// EXERCISE LIBRARY — Banco de exercícios terapêuticos (diferencial Evolua)
// Exercícios nativos de fonoaudiologia por subárea, prescritos para pacientes
// ============================================================================

model ExerciseTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  area         String // "voz" | "disfagia" | "linguagem" | "motricidade_orofacial" | "fluencia" | "audicao"
  subarea      String? // ex: "higiene_vocal", "exercicios_sopro", "estimulacao_lexical"
  description  String
  instructions String // Passo a passo para o paciente
  duration     Int? // duração recomendada em minutos
  frequency    String? // ex: "3x ao dia", "diariamente"
  repetitions  String? // ex: "10 repetições", "5 séries de 30s"
  videoUrl     String?  @map("video_url")
  imageUrl     String?  @map("image_url")
  tags         String[]
  difficulty   String   @default("medium") // "easy" | "medium" | "hard"
  ageGroup     String   @default("all") // "child" | "adult" | "elderly" | "all"
  isSystem     Boolean  @default(true) @map("is_system") // true = nativo do Evolua
  clinicId     String?  @map("clinic_id") @db.Uuid // null = nativo, preenchido = personalizado
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic?                       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  prescriptions PatientExercisePrescription[]

  @@index([area, subarea])
  @@index([clinicId])
  @@map("exercise_templates")
}

model PatientExercisePrescription {
  id                 String    @id @default(uuid()) @db.Uuid
  clinicId           String    @map("clinic_id") @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  therapistId        String    @map("therapist_id") @db.Uuid
  exerciseId         String    @map("exercise_id") @db.Uuid
  treatmentPlanId    String?   @map("treatment_plan_id") @db.Uuid
  customInstructions String?   @map("custom_instructions") // personalizações para este paciente
  frequency          String // ex: "2x ao dia"
  repetitions        String? // ex: "10 repetições"
  durationDays       Int?      @map("duration_days") // quantos dias manter a prescrição
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  status             String    @default("active") // "active" | "completed" | "cancelled"
  sentAt             DateTime? @map("sent_at") @db.Timestamptz // quando foi enviado via WhatsApp/email
  sentVia            String?   @map("sent_via") // "whatsapp" | "email" | "both"
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist     User             @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  exercise      ExerciseTemplate @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  treatmentPlan TreatmentPlan?   @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, status])
  @@index([patientId, startDate])
  @@map("patient_exercise_prescriptions")
}

// ============================================================================
// CAA — Comunicação Aumentativa e Alternativa (pranchas com pictogramas)
// ============================================================================

model CaaBoard {
  id                   String    @id @default(uuid()) @db.Uuid
  clinicId             String    @map("clinic_id") @db.Uuid
  therapistId          String    @map("therapist_id") @db.Uuid
  patientId            String?   @map("patient_id") @db.Uuid
  title                String
  description          String?
  rows                 Int       @default(3)
  cols                 Int       @default(5)
  cells                Json      @default("[]")
  category             String    @default("Personalizado")
