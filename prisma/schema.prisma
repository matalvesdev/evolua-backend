// ============================================================================
// BILLING — Assinaturas SaaS (Evolua → cobranças do CLIENTE da clínica)
// ============================================================================
// NÃO confundir com Transaction (financeiro INTERNO da clínica).
// Migration: 20260512000000_add_billing
// ============================================================================

model Plan {
  id                  String   @id @default(uuid()) @db.Uuid
  slug                String   @unique
  name                String
  description         String?
  amountCents         Int      @map("amount_cents")
  currency            String   @default("BRL") @db.Char(3)
  interval            String   // 'monthly' | 'yearly'
  maxUsers            Int?     @map("max_users")
  maxPatients         Int?     @map("max_patients")
  features            Json     @default("[]")
  isActive            Boolean  @default(true) @map("is_active")
  stripeProductId     String?  @map("stripe_product_id")
  stripePriceId       String?  @map("stripe_price_id")
  abacatepayProductId String?  @map("abacatepay_product_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]

  @@index([slug])
  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id                     String    @id @default(uuid()) @db.Uuid
  clinicId               String    @map("clinic_id") @db.Uuid
  planId                 String    @map("plan_id") @db.Uuid
  provider               String    // 'abacatepay' | 'stripe'
  providerSubscriptionId String    @map("provider_subscription_id")
  status                 String    // trialing | active | past_due | canceled | unpaid | incomplete
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz
  currentPeriodStart     DateTime  @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime  @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime? @map("canceled_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@unique([provider, providerSubscriptionId])
  @@index([clinicId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id                String    @id @default(uuid()) @db.Uuid
  clinicId          String    @map("clinic_id") @db.Uuid
  subscriptionId    String?   @map("subscription_id") @db.Uuid
  provider          String    // 'abacatepay' | 'stripe'
  providerInvoiceId String    @map("provider_invoice_id")
  status            String    // open | paid | void | uncollectible | refunded
  amountCents       Int       @map("amount_cents")
  currency          String    @db.Char(3)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz
  invoiceUrl        String?   @map("invoice_url")
  pdfUrl            String?   @map("pdf_url")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([provider, providerInvoiceId])
  @@index([clinicId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

// Tabela de idempotência: cada webhook que chega é registrado aqui.
// Se o mesmo (provider, externalId) chegar de novo → ignorar.
model BillingEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    // 'abacatepay' | 'stripe'
  externalId  String    @map("external_id")
  type        String    // ex: 'invoice.paid', 'subscription.canceled'
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz

  @@unique([provider, externalId])
  @@index([receivedAt(sort: Desc)])
  @@map("billing_events")
}

