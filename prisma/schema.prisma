// ============================================================================
// WHATSAPP CRM — Histórico de conversas por paciente
// ============================================================================

model WaConversation {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  phone     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic   Clinic      @relation("ClinicWaConversations", fields: [clinicId], references: [id], onDelete: Cascade)
  patient  Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages WaMessage[]

  @@unique([clinicId, patientId])
  @@index([clinicId, updatedAt])
  @@map("wa_conversations")
}

model WaMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  direction      String // "outbound" | "inbound"
  type           String   @default("text") // "text" | "material" | "payment_link"
  content        String
  mediaUrl       String?  @map("media_url")
  paymentLink    String?  @map("payment_link")
  paymentAmount  Decimal? @map("payment_amount") @db.Decimal
  status         String   @default("sent") // "sent" | "delivered" | "read" | "failed"
  evolutionId    String?  @map("evolution_id") // ID retornado pela Evolution API
  sentAt         DateTime @default(now()) @map("sent_at") @db.Timestamptz

  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("wa_messages")
}

// ============================================================================
// THERAPEUTIC MATERIAL — Materiais enviados a pacientes
// ============================================================================

model TherapeuticMaterial {
  id          String    @id @default(uuid()) @db.Uuid
  clinicId    String    @map("clinic_id") @db.Uuid
  therapistId String    @map("therapist_id") @db.Uuid
  title       String
  description String?
  area        String // "fonoaudiologia" | "fisioterapia" | "terapia_ocupacional"
