# ==========================================
# Evolua CRM Backend - Variáveis de Ambiente
# ==========================================
# Em produção (App Runner / Render / etc.), configure no painel do provider.
# NUNCA comite valores reais. Este arquivo serve como referência.

# ==========================================
# Supabase (obrigatório)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Segredo HS256 do JWT do Supabase — usado pelo Fastify para validar tokens
# sem chamar o /auth/v1/user. Pegue em Project Settings > API > JWT Settings.
SUPABASE_JWT_SECRET=your_jwt_secret

# ==========================================
# Database (obrigatório) — Postgres do Supabase
# ==========================================
# Connection pooling (usado pela aplicação)
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Conexão direta (usado para migrations Prisma)
DIRECT_URL=postgresql://postgres.xxx:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ==========================================
# App Fastify (obrigatório)
# ==========================================
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=https://your-app.vercel.app
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
FRONTEND_URL=https://your-app.vercel.app

# Token compartilhado entre Fastify <-> microserviços Python/Go.
# Gere com: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-in-prod-must-be-32-bytes-hex

# URLs internas dos microserviços (em prod use service discovery)
AI_SERVICE_URL=http://localhost:8001
WHATSAPP_SERVICE_URL=http://localhost:8010

# ==========================================
# HuggingFace (obrigatório p/ IA — chat, embeddings, Whisper)
# Crie um token em https://huggingface.co/settings/tokens (read scope)
# ==========================================
HUGGINGFACE_API_KEY=hf_your_token_here

# ==========================================
# Resend (emails transacionais)
# ==========================================
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=naoresponder@useevolua.com.br
RESEND_FROM_NAME=Evolua
CONTACT_NOTIFICATION_EMAIL=contatouseevolua@gmail.com

# ==========================================
# Evolution Go (WhatsApp — gateway no Go)
# Documentação: https://docs.evolutionfoundation.com.br/evolution-go
# ==========================================
EVOLUTION_URL=http://localhost:8080
# GLOBAL_API_KEY definida no .env do Evolution Go
EVOLUTION_API_KEY=sua-chave-segura-aqui
EVOLUTION_INSTANCE=evolua
EVOLUTION_INSTANCE_ID=
# Secret HMAC-SHA256 — OBRIGATÓRIO em produção. Gere com: openssl rand -hex 32
# Mesmo valor deve estar no .env do serviço Go (var de mesmo nome).
EVOLUTION_WEBHOOK_SECRET=

# ==========================================
# Pix BACEN (cobrança via WhatsApp)
# ==========================================
# Sua chave Pix (CPF, CNPJ, e-mail, telefone ou EVP).
PIX_KEY=
# Razão social ou nome do beneficiário (máx 25 chars ASCII).
PIX_MERCHANT_NAME=Clinica Evolua
# Cidade (máx 15 chars ASCII, sem acentos).
PIX_MERCHANT_CITY=SAO PAULO

# ==========================================
# Sentry (observabilidade — recomendado em produção)
# Crie projeto Node em https://sentry.io
# ==========================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
